
menuconfig C2USB_SHELL_BACKEND
    bool "c2usb shell backend"
    depends on SHELL
    help
      Build c2usb shell backend.

if C2USB_SHELL_BACKEND

config C2USB_SHELL_PROMPT
    string "Displayed prompt name"
    default "c2usb:~$ "
    help
      Displayed prompt name for c2usb backend. If prompt is set, the shell will
      send two newlines during initialization.

config SHELL_C2USB_FUNCTION_NAME
    string "Shell USB CDC function name"
    default ""
    help
      Name of the USB CDC function to use for the shell.

config C2USB_SHELL_BACKEND_TX_BUFFER_SIZE
    int "c2usb shell TX double buffer overall size"
    range 128 1024
    default 1024 if UDC_DRIVER_HIGH_SPEED_SUPPORT_ENABLED
    default 128

config C2USB_SHELL_BACKEND_RX_BUFFER_SIZE
    int "c2usb shell RX double buffer overall size"
    range 32 1024
    default 1024 if UDC_DRIVER_HIGH_SPEED_SUPPORT_ENABLED
    default 128

module = C2USB_SHELL_BACKEND
default-timeout = 100
source "subsys/shell/Kconfig.template.shell_log_queue_timeout"

default-size = 512
source "subsys/shell/Kconfig.template.shell_log_queue_size"

module-str = c2usb shell backend
source "subsys/logging/Kconfig.template.log_config"


menuconfig C2USB_SHELL_MCUMGR_TRANSPORT
    bool "c2usb shell MCUmgr SMP transport"
    depends on SHELL
    depends on BASE64
    depends on CRC
    select MCUMGR_TRANSPORT_SERIAL_HAS_SMP_OVER_CONSOLE
    help
      Enables handling of SMP commands received over shell. This allows the shell to be use
      for both MCUmgr commands and shell commands.

if C2USB_SHELL_MCUMGR_TRANSPORT

config C2USB_SHELL_MCUMGR_TRANSPORT_MTU
    int "c2usb shell SMP MTU"
    default 256
    help
      Maximum size of SMP frames sent and received over shell. This value must satisfy the
      following relation:
      C2USB_SHELL_MCUMGR_TRANSPORT_MTU <= MCUMGR_TRANSPORT_NETBUF_SIZE + 2

config C2USB_SHELL_MCUMGR_TRANSPORT_INPUT_TIMEOUT_TIME
    int "c2usb shell input expiration timeout"
    default 0
    help
      Time (in ms) after receiving a valid MCUmgr header on the serial transport before
      considering it as timed out and returning the shell to normal operation.
      Set to 0 to disable the input expiration timeout.

endif # C2USB_SHELL_MCUMGR_TRANSPORT

endif # C2USB_SHELL_BACKEND
