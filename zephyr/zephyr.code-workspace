{
	"folders": [
		{
			"path": ".."
		},
		{
			"path": "examples/ble-keyboard"
		},
		{
			"path": "examples/usb-keyboard"
		},
		{
			"path": "examples/usb-ncm-zperf"
		},
		{
			"path": "examples/usb-shell"
		},
		{
			"path": "../../modules/lib/hid-rp"
		},
		{
			"path": "../../zephyr"
		},
		{
			"name": "workspace",
			"path": "../.."
		}
	],
	"settings": {
		"nrf-connect.applications": [
			"${workspaceFolder:ble-keyboard}",
			"${workspaceFolder:usb-keyboard}",
			"${workspaceFolder:usb-shell}"
		],
		"files.associations": {
			"*.h": "c",
			"*.c": "c",
			"*.hpp": "cpp",
			"*.cpp": "cpp"
		},
		"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
		"C_Cpp.workspaceParsingPriority": "low",
		"C_Cpp.autoAddFileAssociations": false,
		"cmake.useCMakePresets": "always",
		"cmake.configureOnOpen": false,
		"cmake.enableAutomaticKitScan": false,
		"cmake.options.advanced": {
			"build": {
				"statusBarVisibility": "hidden"
			},
			"launch": {
				"statusBarVisibility": "hidden"
			},
			"debug": {
				"statusBarVisibility": "hidden"
			}
		},
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features",
			"editor.formatOnSave": true
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features",
			"editor.formatOnSave": true
		},
		"[c]": {
			"editor.defaultFormatter": "xaver.clang-format",
			"editor.formatOnSave": true
		},
		"[cpp]": {
			"editor.defaultFormatter": "xaver.clang-format",
			"editor.formatOnSave": true
		},
		"task.allowAutomaticTasks": "on",
		"c2usb.startupSdk": "nrfsdk",
		"C_Cpp.inlayHints.parameterNames.enabled": true,
		"C_Cpp.inlayHints.autoDeclarationTypes.showOnLeft": true,
		"C_Cpp.inlayHints.referenceOperator.enabled": true,
		"C_Cpp.formatting": "clangFormat",
		"terminal.integrated.stickyScroll.enabled": false,
		"clangd.arguments": [
			"--header-insertion=never",
			"--completion-style=detailed",
			"--query-driver=/opt/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/*"
		]
	},
	"extensions": {
		"recommendations": [
			"ac6.zephyr-workbench",
			"ms-vscode.cpptools-extension-pack",
			"ms-vscode.vscode-embedded-tools",
			"mcu-debug.peripheral-viewer",
			"mcu-debug.memory-view",
			"mcu-debug.rtos-views",
			"nordic-semiconductor.nrf-kconfig"
		]
	}
}