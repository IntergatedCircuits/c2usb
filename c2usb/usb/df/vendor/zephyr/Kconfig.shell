
menuconfig C2USB_SHELL_BACKEND
    bool "c2usb shell backend"
    depends on SHELL
    help
      Build c2usb shell backend.

if C2USB_SHELL_BACKEND

config C2USB_SHELL_PROMPT
    string "Displayed prompt name"
    default "c2usb:~$ "
    help
      Displayed prompt name for c2usb backend. If prompt is set, the shell will
      send two newlines during initialization.

config SHELL_C2USB_FUNCTION_NAME
    string "Shell USB CDC function name"
    default ""
    help
      Name of the USB CDC function to use for the shell.

config C2USB_SHELL_BACKEND_TX_BUFFER_SIZE
    int "c2usb shell TX double buffer overall size"
    range 128 1024
    default 1024 if UDC_DRIVER_HIGH_SPEED_SUPPORT_ENABLED
    default 128

config C2USB_SHELL_BACKEND_RX_BUFFER_SIZE
    int "c2usb shell RX double buffer overall size"
    range 32 1024
    default 1024 if UDC_DRIVER_HIGH_SPEED_SUPPORT_ENABLED
    default 128

module = C2USB_SHELL_BACKEND
default-timeout = 100
source "subsys/shell/Kconfig.template.shell_log_queue_timeout"

default-size = 512
source "subsys/shell/Kconfig.template.shell_log_queue_size"

module-str = c2usb shell backend
source "subsys/logging/Kconfig.template.log_config"

endif # C2USB_SHELL_BACKEND
