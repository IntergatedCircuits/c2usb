From: Jay Beavers <jay@tolttechnologies.com>
Date: Thu, 19 Nov 2026 23:25:48 +0100
Subject: [PATCH] drivers: udc_nrf: report VBUS from the regulator level,
 not event order

USBDETECTED and USBREMOVED stay latched while the interrupt is disabled,
for example between shutdown and init of the driver, across a reset or
while a debugger halts the core. The nrfx handlers dispatch them in a
fixed order, DETECTED before REMOVED. If VBUS dropped and returned in
that window, udc_nrf_power_handler() reported VBUS_READY and then
VBUS_REMOVED. The stack stayed disabled with VBUS present: USBD
ENABLE=0, USBREGSTATUS=1 and no further event to recover it.

Both events now only trigger a read of USBREGSTATUS, and a READY or
REMOVED is submitted when the level differs from what was last
reported. Init clears the tracked state and syncs once after enabling
the events. This also covers VBUS present with no edge latched, and
replaces the resubmit from the stale flag added in commit 789f5ca31807
("drivers: udc_nrf: submit UDC_EVT_VBUS_READ if VBUS is still present").

A VBUS blip that is over before the handler runs is no longer reported
as a removal, so the stack does not disable and re-enable USBD.

Signed-off-by: Jay Beavers <jay@tolttechnologies.com>
---
 drivers/usb/udc/udc_nrf.c | 33 +++++++++++++++++++++++++--------
 1 file changed, 25 insertions(+), 8 deletions(-)

diff --git a/drivers/usb/udc/udc_nrf.c b/drivers/usb/udc/udc_nrf.c
index 81aa85c2266..23d7f9854e3 100644
--- a/drivers/usb/udc/udc_nrf.c
+++ b/drivers/usb/udc/udc_nrf.c
@@ -1511,13 +1511,27 @@ static void udc_nrf_thread(void *p1, void *p2, void *p3)
 	}
 }
 
+/* Report VBUS from the regulator's level. DETECTED and REMOVED latched together are
+ * dispatched in a fixed order, so taking them at face value can end on "removed".
+ */
+static void udc_nrf_vbus_sync(void)
+{
+	bool now = nrfx_power_usbstatus_get() != NRFX_POWER_USB_STATE_DISCONNECTED;
+
+	if (now == vbus_present) {
+		return;
+	}
+
+	vbus_present = now;
+	udc_submit_event(udc_nrf_dev, now ? UDC_EVT_VBUS_READY : UDC_EVT_VBUS_REMOVED, 0);
+}
+
 static void udc_nrf_power_handler(nrfx_power_usb_evt_t pwr_evt)
 {
 	switch (pwr_evt) {
 	case NRFX_POWER_USB_EVT_DETECTED:
 		LOG_DBG("POWER event detected");
-		udc_submit_event(udc_nrf_dev, UDC_EVT_VBUS_READY, 0);
-		vbus_present = true;
+		udc_nrf_vbus_sync();
 		break;
 	case NRFX_POWER_USB_EVT_READY:
 		LOG_DBG("POWER event ready");
@@ -1525,8 +1539,7 @@ static void udc_nrf_power_handler(nrfx_power_usb_evt_t pwr_evt)
 		break;
 	case NRFX_POWER_USB_EVT_REMOVED:
 		LOG_DBG("POWER event removed");
-		udc_submit_event(udc_nrf_dev, UDC_EVT_VBUS_REMOVED, 0);
-		vbus_present = false;
+		udc_nrf_vbus_sync();
 		break;
 	default:
 		LOG_ERR("Unknown power event %d", pwr_evt);
@@ -1748,14 +1761,12 @@ static int udc_nrf_disable(const struct device *dev)
 static int udc_nrf_init(const struct device *dev)
 {
 	const struct udc_nrf_config *cfg = dev->config;
+	unsigned int key;
 
 #if defined(CONFIG_CLOCK_CONTROL_NRF)
 	hfxo_mgr = z_nrf_clock_control_get_onoff(cfg->clock);
 #endif
-
-	if (vbus_present) {
-		udc_submit_event(udc_nrf_dev, UDC_EVT_VBUS_READY, 0);
-	}
+	vbus_present = false;
 
 #ifdef CONFIG_HAS_HW_NRF_USBREG
 	/* Use CLOCK/POWER priority for compatibility with other series where
@@ -1779,6 +1790,12 @@ static int udc_nrf_init(const struct device *dev)
 	nrfx_power_usbevt_init(&cfg->evt);
 
 	nrfx_power_usbevt_enable();
+
+	/* A re-init, or VBUS already present with no edge latched, raises no event. */
+	key = irq_lock();
+	udc_nrf_vbus_sync();
+	irq_unlock(key);
+
 	LOG_INF("Initialized");
 
 	return 0;
-- 
2.53.0

